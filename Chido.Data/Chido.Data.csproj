<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pomelo 8.0.2 は Microsoft.EntityFrameworkCore.Relational を [8.0.2, 8.0.999] にピン留めしている。
         その範囲の上端側（8.0.x の最新パッチ）を明示的に選ぶ。
         EF Core 8.0.2 には ElementMappingConvention がモデル確定時に NullReferenceException を投げる不具合があり、
         値コンバータの provider 型が byte[] の列（GuidToBinaryConverter → BINARY(16)）を
         プリミティブコレクションと誤認することで発生する。
         この不具合はモデルの確定処理そのものを落とすため、マイグレーション生成も実行時のDB接続もできない。
         Design パッケージも同じバージョンに揃え、Chido側との参照バージョン不一致(CS1705)を防ぐ -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- EntityType / ActionType / BattleEndReason 列挙体を再利用するため参照 -->
    <ProjectReference Include="..\Chido.Core\Chido.Core.csproj" />
  </ItemGroup>
</Project>
