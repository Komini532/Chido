DISCORD_TOKEN=your_bot_token_here
# Optional: set to a guild (server) ID to register slash commands instantly for that guild during development.
# Omit (or leave unset) to register commands globally, which can take up to an hour to propagate.
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs allowed to run admin commands (e.g. /admin-db-migrate).
# Read by Chido/Administration/AdminAuthorization.cs. Leave unset to disable every admin command.
DISCORD_ADMIN_USER_IDS=

# MySQL connection string used by Chido.Data (ChidoDbContextFactory).
# Any DB-backed command throws if this is unset.
# Example: Server=localhost;Port=3306;Database=chido;User=chido;Password=your_password_here;
CHIDO_MYSQL_CONNECTION=
